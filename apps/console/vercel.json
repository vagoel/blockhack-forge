{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && pnpm --filter console build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/presentation",
      "destination": "/presentation/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
