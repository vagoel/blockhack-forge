{
  // Shared Devin CLI project settings for the blockhack-forge team.
  // Personal overrides go in .devin/config.local.json (gitignored).
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(npm run)",
      "Exec(npx convex)"
    ],
    "deny": [
      "Exec(sudo)",
      "Read(**/.env*)",
      "Write(**/.env*)"
    ]
  }
}
